# Copy this file to `.env` and replace every value before running `docker compose up`.
# `.env` is git-ignored; never commit real secrets.

# --- SQL Server ---
# Must satisfy SQL Server complexity rules (8+ chars, upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=

# --- API / JWT ---
# Unique secret of at least 32 characters. Generate one, e.g.:
#   openssl rand -base64 48
JWT__KEY=

# --- Default administrator created on first startup ---
ADMIN__USERNAME=admin
ADMIN__EMAIL=
ADMIN__PASSWORD=
