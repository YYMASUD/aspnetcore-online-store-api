{
  "_comment": "Copy to appsettings.Development.json or use dotnet user-secrets / environment variables. Never commit real secrets.",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/storeapi-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=StoreApiDb;User Id=sa;Password=REPLACE_ME;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "StoreApi",
    "Audience": "StoreApi.Clients",
    "Key": "REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS",
    "ExpiryMinutes": 60
  },
  "Admin": {
    "Username": "admin",
    "Email": "admin@storeapi.local",
    "Password": "REPLACE_WITH_A_STRONG_PASSWORD"
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10
    }
  },
  "AllowedHosts": "*"
}
